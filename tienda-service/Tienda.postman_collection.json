{
  "info": {
    "name": "Veterinaria San Marcos - Tienda",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8083"
    },
    {
      "key": "pedidoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "Consultar producto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/productos/ME001"
      }
    },
    {
      "name": "Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"ME023\",\n  \"nombre\": \"Producto de prueba\",\n  \"categoria\": \"Accesorios\",\n  \"precio\": 3500,\n  \"stock\": 10,\n  \"imagen\": \"/img/Amoxibay.jpg\",\n  \"principioActivo\": \"\",\n  \"presentacion\": \"Unidad\",\n  \"especie\": \"Perro / Gato\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Editar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos/ME023",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"ME023\",\n  \"nombre\": \"Producto de prueba\",\n  \"categoria\": \"Accesorios\",\n  \"precio\": 4000,\n  \"stock\": 10,\n  \"imagen\": \"/img/Amoxibay.jpg\",\n  \"principioActivo\": \"\",\n  \"presentacion\": \"Unidad\",\n  \"especie\": \"Perro / Gato\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Actualizar stock",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/productos/ME023/stock",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": 15\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Desactivar producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/productos/ME023"
      }
    },
    {
      "name": "Crear pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"Cliente de prueba\",\n  \"correo\": \"cliente@example.com\",\n  \"direccion\": \"Av. Brasil 2140, Rancagua\",\n  \"metodo\": \"Transferencia\",\n  \"productos\": [\n    {\n      \"codigo\": \"ME001\",\n      \"cantidad\": 2\n    },\n    {\n      \"codigo\": \"ME004\",\n      \"cantidad\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pedido creado\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos"
      }
    },
    {
      "name": "Consultar pedido",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}"
      }
    },
    {
      "name": "Cancelar pedido",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/estado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"CANCELADO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Marcar enviado",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/estado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"ENVIADO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Marcar entregado",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pedidos/{{pedidoId}}/estado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"ENTREGADO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
